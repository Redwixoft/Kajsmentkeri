@page "/santa"
@model Kajsmentkeri.Web.Pages.SantaModel
@{
    ViewData["Title"] = "Secret Santa";
}

<div class="container mt-4" style="max-width: 640px;">
    <h2>🎅 Secret Santa</h2>

    <div class="alert alert-info">
        You are invited to a <strong>Secret Santa</strong> session on <strong>@Model.EventDate</strong>!
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Rules.Count == 0)
    {
        <p>
            By accepting this invitation, you agree to bring a Secret Santa gift. The gift has to follow
            a set of rules that will be randomly assigned to you once you accept.
        </p>
        <p>After accepting, you will also see more details about the event, such as the venue and time.</p>
        <form method="post">
            <button type="submit" class="btn btn-danger btn-lg" onclick="this.disabled=true; this.form.submit();">Accept</button>
        </form>
    }
    else
    {
        <h4 class="mt-3">Your gift has to follow these rules:</h4>
        <ol class="list-group list-group-numbered mt-2">
            @foreach (var rule in Model.Rules)
            {
                <li class="list-group-item">@rule</li>
            }
        </ol>

        <h4 class="mt-4">Event details</h4>
        <ul class="list-group mt-2">
            <li class="list-group-item"><strong>Date:</strong> @Model.EventDate</li>
            <li class="list-group-item"><strong>Time:</strong> @(Model.EventTime ?? "To be announced")</li>
            <li class="list-group-item"><strong>Venue:</strong> @(Model.Venue ?? "To be announced")</li>
        </ul>
    }
</div>
